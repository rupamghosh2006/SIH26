# VARUNA — Environment Configuration Example

# JWT Secret for Session Tokens
JWT_SECRET=supersecret-varuna-defense-key-2026

# FastAPI Microservice Base URL
FASTAPI_BASE_URL=https://varuna-sonar-backend.onrender.com
NEXT_PUBLIC_API_URL=https://varuna-sonar-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://varuna-sonar-backend.onrender.com

# Optional: MongoDB Connection URI (If not set, system seamlessly runs in Edge/Demo Mode)
# MONGODB_URI=mongodb://localhost:27017/varuna

# Optional: Google OAuth 2.0 Credentials (From Google Cloud Console: https://console.cloud.google.com/)
# Set Authorized redirect URI to: http://localhost:3000/api/auth/google/callback
# If not provided, Google Sign-In automatically authenticates via verified officer demo profile.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
